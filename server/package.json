{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node ../scripts/write-build-info.mjs",
    "dev": "tsx watch --tsconfig tsconfig.json --include ../modules/**/server/** --include ../modules/**/db/** src/index.ts",
    "prebuild": "node ../scripts/write-build-info.mjs",
    "pretest": "node ../scripts/write-build-info.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:llm": "vitest run --config vitest.live.config.ts",
    "test:llm:reasoning": "vitest run --config vitest.live.reasoning.config.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "@llm-tg-bot/modules-addressing-detection": "*",
    "@llm-tg-bot/modules-mood-evaluation": "*",
    "@llm-tg-bot/modules-mood-evaluation-db": "*",
    "@llm-tg-bot/modules-history": "*",
    "@llm-tg-bot/modules-history-db": "*",
    "@llm-tg-bot/modules-vision": "*",
    "@llm-tg-bot/modules-sticker-selection": "*",
    "@llm-tg-bot/modules-link-fetch": "*",
    "@llm-tg-bot/modules-memory": "*",
    "@llm-tg-bot/modules-memory-db": "*",
    "@llm-tg-bot/modules-search-decision": "*",
    "@llm-tg-bot/modules-registry": "*",
    "@llm-tg-bot/modules-utils": "*",
    "@llm-tg-bot/modules-web-search": "*",
    "openai": "^6.42.0",
    "playwright": "^1.52.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
