{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@llm-tg-bot/modules-utils": ["./src/modules/utils/src/index.ts"],
      "@llm-tg-bot/modules-addressing-detection": [
        "./src/modules/addressing-detection/src/index.ts"
      ],
      "@llm-tg-bot/modules-search-decision": [
        "./src/modules/search-decision/src/index.ts"
      ],
      "@llm-tg-bot/modules-web-search": [
        "./src/modules/web-search/src/index.ts"
      ],
      "@llm-tg-bot/modules-memory": [
        "./src/modules/memory/src/index.ts"
      ],
      "@llm-tg-bot/modules-link-fetch": [
        "./src/modules/link-fetch/src/index.ts"
      ],
      "@llm-tg-bot/modules-sticker-selection": [
        "./src/modules/sticker-selection/src/index.ts"
      ]
    }
  },
  "files": ["src/index.ts"]
}
