{
  "name": "llm-tg-bot",
  "version": "2.2.0",
  "private": true,
  "description": "Telegram bot powered by an OpenAI-compatible chat completions API with a configuration dashboard",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n server,dashboard -c blue,green \"npm run dev -w server\" \"npm run dev -w dashboard\"",
    "build": "npm run build -w dashboard && npm run build -w server",
    "typecheck": "node scripts/typecheck-all.mjs",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "test:llm": "npm run test:llm -w server",
    "test:llm:reasoning": "npm run test:llm:reasoning -w server",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version"
  },
  "workspaces": [
    "server",
    "dashboard"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
