BOT_TOKEN=your_telegram_bot_token_here

# Docker secrets: any variable also accepts a `<NAME>_FILE` variant pointing at a
# file whose contents are used instead (e.g. BOT_TOKEN_FILE=/run/secrets/bot_token,
# TAVILY_API_KEY_FILE=..., PG_PASSWORD_FILE=... to override the DATABASE_URL password).
# See docker-compose.yml for a ready-to-uncomment `secrets:` example.

# Logging: ERROR (default) | DEBUG
# LOGGING_LEVEL=ERROR

# Optional: Tavily web search (https://tavily.com)
# TAVILY_API_KEY=tvly-...

# Required: OpenAI-compatible API base URL (e.g. https://your-host/v1 or https://your-host)
LLM_BASE_URL=https://your-localai-host/v1

# Optional: API key for authenticated OpenAI-compatible endpoints. Local servers can leave it unset.
# LLM_API_KEY=sk-...

# Optional: separate base URL for the embedding model. Falls back to LLM_BASE_URL when unset.
# EMBEDDING_BASE_URL=https://your-embedding-host/v1

# Optional: API key for the embedding host. Falls back to LLM_API_KEY when unset.
# EMBEDDING_API_KEY=sk-...

# Optional: separate base URL for image generation. Falls back to LLM_BASE_URL when unset.
# IMAGE_GENERATION_BASE_URL=https://your-image-host/v1

# Optional: API key for the image host. Falls back to LLM_API_KEY when unset.
# IMAGE_GENERATION_API_KEY=sk-...

# Required for npm run test:llm -w server
# LLM_MODEL=your-model-name

# Optional: reasoning live suite sets LLM_THINKING_ENABLED=1 via npm run test:llm:reasoning -w server

# The context window (numCtx) is configured in the dashboard, not via env. It is
# capped to the selected model's native maximum at request time.

# Required: Postgres (with pgvector) connection string. `docker compose up` starts a
# pgvector service; for local dev point this at your own Postgres.
DATABASE_URL=postgres://bot:bot@localhost:5432/bot

# Optional: Postgres credentials + data dir for the bundled docker compose `db` service.
# POSTGRES_USER=bot
# POSTGRES_PASSWORD=bot
# POSTGRES_DB=bot
# PG_DATA_DIR=./data/pg

# Embedding model for history-summary RAG is chosen in the dashboard (Settings →
# Embedding model) from your provider's models — e.g. pull one on ollama:
# `ollama pull bge-m3`. No default; summaries are skipped until one is selected.

# Image generation model is chosen in the dashboard (Settings → Image model) from
# your provider's models. No default; the image_generate tool is unavailable until
# one is selected (the model selection is the on/off switch).

# Optional: IANA timezone for scheduled tasks + daily summaries (default UTC).
# TZ=Europe/Berlin

# Optional: for agents to debug live env
PUBLIC_URL=