{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -File \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/check-codegraph.ps1\"",
            "statusMessage": "Syncing + checking codegraph...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
